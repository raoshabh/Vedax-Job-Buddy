# ─────────────────────────────────────────────────────────────
# JobTracker AI — server configuration (copy to .env)
# Everything is optional; the app runs out of the box with the
# keyless providers (Greenhouse + Remotive). Add Adzuna for India coverage.
# ─────────────────────────────────────────────────────────────

# Auth
JWT_SECRET=change-me-in-production
PORT=3001

# ── Adzuna (free key — best India coverage) ──
# Sign up at https://developer.adzuna.com to get an app id + key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_PER_PAGE=50

# ── Greenhouse direct-ATS boards (keyless) ──
# Comma-separated public board tokens. These are also the safe auto-apply lane.
GREENHOUSE_COMPANIES=stripe,gitlab,databricks,dropbox,airbnb,gusto,coinbase,robinhood,figma,asana
GREENHOUSE_PER_COMPANY=60

# ── Remotive (keyless) ──
REMOTIVE_ENABLED=true
REMOTIVE_LIMIT=120

# Ingestion freshness
INGEST_TTL_MINUTES=360
MIN_JOBS_THRESHOLD=25
FETCH_TIMEOUT_MS=15000

# ── WhatsApp daily digest (Meta Cloud API) ──
# Leave blank to run in MOCK mode (digests are logged to the server console).
# Get these from Meta: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional approved template (required for business-initiated sends outside the
# 24h window). Suggested body: "Hi {{1}}, today you applied to {{2}} jobs
# ({{3}} active, {{4}} interviews). Open JobBuddy to see more."
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Digest scheduling (India-first defaults)
DIGEST_DEFAULT_HOUR=20
DIGEST_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
DASHBOARD_URL=http://localhost:5173
